# Telegram
BOT_TOKEN=
PORT=8080

# Database / Redis
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/gifts
REDIS_URL=redis://redis:6379/0

# Admin
ADMIN_IDS=

# Polling
POLL_INTERVAL_SECONDS=15
DEFAULT_MIN_PROFIT_TON=0.2
DEFAULT_MIN_ROI=10
MAX_LISTING_AGE_SECONDS=120
TON_PRICE_PROVIDER=
TON_USD_RATE_CACHE_SECONDS=60

# Marketplaces (включать только после проверки доступности)
ENABLE_TELEGRAM_NATIVE=false
ENABLE_FRAGMENT=false
ENABLE_GETGEMS=false
ENABLE_PORTALS=false
ENABLE_TONNEL=false
ENABLE_MRKT=false
ENABLE_THERMOS=false

# Auth data (не коммитить реальные значения!)
PORTALS_AUTH_DATA=
TONNEL_AUTH_DATA=
THERMOS_API_TOKEN=
TONAPI_KEY=

# Fees / slippage defaults
DEFAULT_SLIPPAGE_RESERVE_TON=0.05
NETWORK_FEE_TON=0.05
TELEGRAM_TRANSFER_FEE_TON=0.03

# Cards
CARD_FONT_PATH=assets/fonts/Inter-Regular.ttf
CARD_FONT_BOLD_PATH=assets/fonts/Inter-Bold.ttf
CARD_CACHE_DIR=.cache/cards
IMAGE_CACHE_DIR=.cache/images
